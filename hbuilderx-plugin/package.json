{
  "id": "cqsort-cc-gui",
  "name": "cqsort-cc-gui",
  "displayName": "CC GUI（Claude or Codex）",
  "description": "Claude Code / OpenAI Codex 可视化助手（HBuilderX 版）",
  "version": "0.2.3",
  "publisher": "重庆柔然科技有限公司",
  "repository": "https://github.com/wcj343169893/hbuilderx-cc-gui.git",
  "homepage": "https://github.com/wcj343169893/hbuilderx-cc-gui",
  "bugs": {
    "url": "https://github.com/wcj343169893/hbuilderx-cc-gui/issues"
  },
  "engines": {
    "HBuilderX": "^5.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension",
  "activationEvents": [
    "*",
    "onCommand:extension.ccgui.open",
    "onCommand:extension.ccgui.sendSelection",
    "onCommand:extension.ccgui.addFile",
    "onCustomEditor:ccgui.diffEditor",
    "onView:ccgui.chatView"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "ccgui.diffEditor",
        "displayName": "CC GUI Diff",
        "selector": [
          {
            "fileNamePattern": "*.ccdiff"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "extension.ccgui.open",
        "title": "打开 CC GUI 助手"
      },
      {
        "command": "extension.ccgui.sendSelection",
        "title": "发送选中代码到 CC GUI"
      },
      {
        "command": "extension.ccgui.addFile",
        "title": "添加文件到 CC GUI"
      }
    ],
    "keybindings": [
      {
        "command": "extension.ccgui.open",
        "key": "ctrl+alt+c"
      },
      {
        "command": "extension.ccgui.sendSelection",
        "key": "ctrl+alt+a",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "extension.ccgui.sendSelection",
          "group": "z_commands",
          "when": "editorTextFocus",
          "title": "发送选中代码到 CC GUI"
        }
      ],
      "explorer/context": [
        {
          "command": "extension.ccgui.addFile",
          "group": "z_commands",
          "when": "explorerResourceCount == 1 && !explorerResourceIsFolder",
          "title": "添加文件到 CC GUI"
        }
      ]
    },
    "icons": {
      "ccgui": {
        "description": "CC GUI",
        "default": {
          "fontPath": "./icons/ccgui-iconfont.ttf",
          "fontCharacter": "\\e900"
        }
      }
    },
    "viewsContainers": {
      "rightside": [
        {
          "id": "ccgui.container",
          "title": "CC GUI"
        }
      ]
    },
    "views": {
      "ccgui.container": [
        {
          "id": "ccgui.chatView",
          "name": "CC GUI",
          "title": "CC GUI（Claude or Codex）"
        }
      ]
    },
    "configuration": {
      "title": "CC GUI",
      "properties": {
        "ccgui.nodePath": {
          "type": "string",
          "default": "",
          "description": "Node.js 可执行文件路径（留空则自动探测系统 Node）"
        },
        "ccgui.claudeCliPath": {
          "type": "string",
          "default": "",
          "description": "自定义 Claude CLI 路径（留空则使用 PATH 中的 claude）"
        },
        "ccgui.permissionMode": {
          "type": "string",
          "default": "askAlways",
          "enum": [
            "askAlways",
            "acceptEdits",
            "bypassPermissions",
            "plan"
          ],
          "description": "权限模式"
        },
        "ccgui.debugLog": {
          "type": "boolean",
          "default": false,
          "description": "在「CC GUI」输出面板显示调试日志（默认关闭；无论开关都会记录到 ~/.codemoss/ccgui-debug.log）"
        },
        "ccgui.autoRetryEnabled": {
          "type": "boolean",
          "default": true,
          "description": "发送遇到瞬时错误（如 DeepSeek 偶发的「API request failed」、超时、5xx、网络中断）时自动重试。仅在本轮尚未产出内容的早期失败时重试；鉴权类错误(401/无效密钥等)不重试。"
        },
        "ccgui.autoRetryCount": {
          "type": "number",
          "default": 3,
          "description": "自动重试的最大次数（0~10，0 表示不重试）。总尝试次数 = 1 + 该值。"
        },
        "ccgui.autoRetryDelaySeconds": {
          "type": "number",
          "default": 3,
          "description": "每次自动重试前的等待秒数（1~60）。"
        },
        "ccgui.deepseekPeakGuard": {
          "type": "boolean",
          "default": true,
          "description": "使用 DeepSeek 且处于高峰时段（北京时间 9:00-12:00、14:00-18:00，价格 2 倍）发送前，弹窗提示并让你选择：制定开发计划 / 加入队列(平价自动执行) / 立即发送(选思考深度) / 取消。"
        },
        "ccgui.deepseekAutoQueueExecute": {
          "type": "boolean",
          "default": true,
          "description": "平价时段自动分批执行 DeepSeek 队列中的任务（每个任务用全新会话，避免上下文膨胀）。关闭后队列仅保留、不自动执行。"
        },
        "ccgui.deepseekModelEasy": {
          "type": "string",
          "default": "",
          "description": "平价自动执行时，判定为「简单」的任务使用的模型 id（留空则用当前模型）。例如成本更低的模型。"
        },
        "ccgui.deepseekModelHard": {
          "type": "string",
          "default": "",
          "description": "平价自动执行时，判定为「复杂」的任务使用的模型 id（留空则用当前模型）。例如推理更强的模型。"
        }
      }
    }
  },
  "dependencies": {},
  "scripts": {
    "bundle": "node scripts/bundle.js"
  },
  "dcloudext": {
    "type": "hbuilderx",
    "sale": {
      "regular": {
        "price": "0.00"
      },
      "sourcecode": {
        "price": "0.00"
      }
    },
    "contact": {
      "qq": ""
    },
    "declaration": {
      "ads": "无",
      "data": "插件不采集任何数据",
      "permissions": "无"
    },
    "npmurl": "",
    "darkmode": "-",
    "i18n": "-",
    "widescreen": "-"
  },
  "keywords": [
    "claude",
    "codex",
    "AI",
    "agent"
]
}
